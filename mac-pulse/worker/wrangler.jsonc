{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mac-pulse",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mac-pulse",
      // From `npx wrangler d1 create mac-pulse`.
      "database_id": "d61b2120-8b16-4e73-aa33-85ac330f6f1c",
      "migrations_dir": "migrations"
    }
  ],
  // Alerts every 5 minutes; the run at minute 0 also builds the hourly rollup.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // Alert when no sample arrives for this many minutes. 0 disables it
    // (a laptop that sleeps at night would otherwise alert every night).
    "STALE_MINUTES": "0",
    "DISK_LOW_GB": "10",
    "TZ": "Asia/Tokyo"
  },
  // Secrets (wrangler secret put): ACCESS_AUD, DISCORD_WEBHOOK_URL (optional).
  // `wrangler dev` simulates Cloudflare Access with this identity; set
  // ACCESS_AUD=local-dev in .dev.vars to match.
  "access": {
    "dev": { "aud": "local-dev", "identity": { "email": "dev@example.com" } }
  },
  "observability": { "enabled": true },
  "env": {
    // Preview: a separate Worker (mac-pulse-preview) with its own D1, deployed
    // from branch pushes (`--env preview`). Secrets: ACCESS_AUD only; without
    // DISCORD_WEBHOOK_URL, alerts are only logged. vars and d1_databases are
    // not inherited, so they are repeated here.
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mac-pulse-preview",
          // From `npx wrangler d1 create mac-pulse-preview`.
          "database_id": "TODO",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "STALE_MINUTES": "0",
        "DISK_LOW_GB": "10",
        "TZ": "Asia/Tokyo"
      }
    }
  }
}
